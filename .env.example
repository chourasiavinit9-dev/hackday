# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemma 4 Reasoning Model (defaults to gemma-4-27b-it, with automatic fallback)
GEMMA_MODEL=gemma-4-27b-it

# Multimodal Engine for Voice-to-Text & Video (gemini-2.0-flash or gemini-1.5-flash)
MULTIMODAL_MODEL=gemini-2.0-flash
