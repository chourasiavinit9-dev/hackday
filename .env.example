# SkillForge Environment Variables Example
# Duplicate this file to .env and fill in your values

# Google / DigitalOcean GenAI API key for Gemma 4
GEMINI_API_KEY=your_genai_api_key_here

# Gemma model name
GEMMA_MODEL=gemma-4-26b-a4b-it

# Database URL (leave empty for local SQLite, or set PostgreSQL connection string)
# Example Render/DigitalOcean: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=

# Port to bind
PORT=8000

# Set to true for mock responses without an active API key
SKILLFORGE_DEMO=false
